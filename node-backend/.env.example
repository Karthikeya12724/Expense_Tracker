# MySQL — reuse the same database your Spring Boot backend used
DB_HOST=localhost
DB_PORT=3306
DB_NAME=expense_tracker
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD

# JWT
JWT_SECRET=======================expense=tracker=mywallet===========================
JWT_EXPIRATION_MS=86400000

# Email (Gmail example — use an App Password, not your real password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=YOUR_EMAIL
MAIL_PASSWORD=YOUR_EMAIL_APP_PASSWORD

# Misc
VERIFICATION_CODE_EXPIRATION_MS=600000
PROFILE_UPLOAD_DIR=./uploads/user/profile
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
